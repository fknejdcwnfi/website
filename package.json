{
  "name": "vermouth-character-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal pixel website rebuilt from the owner-provided Fuji wind animation source.",
  "scripts": {
    "prebuild": "npm test",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/tests/run.mjs",
    "deploy": "bash scripts/deploy/deploy_gh_pages.sh",
    "assets": "python3 scripts/assets/optimize_assets.py",
    "assets:check": "python3 scripts/assets/optimize_assets.py --check",
    "assets:verify": "python3 scripts/assets/verify_assets.py && python3 scripts/assets/optimize_pixel_ui.py --verify && python3 scripts/assets/prepare_pixel_font.py --verify && python3 scripts/assets/prepare_responsive_decor.py --verify && npm run repo:verify",
    "scene:verify": "python3 scripts/assets/verify_poetic_pixel_scene.py",
    "scene:derive": "python3 scripts/assets/derive_poetic_motion.py",
    "source:verify": "python3 scripts/assets/verify_reference_project.py",
    "scene:export": "python3 scripts/assets/export_poetic_pixel_scene.py",
    "scene:qa": "python3 scripts/qa/verify_final_scene.py",
    "profile:qa": "python3 scripts/qa/verify_profile_modules.py",
    "scene:capture": "python3 scripts/qa/capture_final_scene.py",
    "scene:measure": "python3 scripts/qa/capture_final_scene.py --measure",
    "assets:ui:check": "python3 scripts/assets/optimize_pixel_ui.py --check",
    "repo:verify": "python3 scripts/tests/test_repository_structure.py && python3 scripts/qa/verify_repository_structure.py",
    "assets:font:check": "python3 scripts/assets/prepare_pixel_font.py --check",
    "assets:responsive:check": "python3 scripts/assets/prepare_responsive_decor.py --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
