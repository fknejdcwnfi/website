{
  "name": "vermouth-character-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A customizable pixel-style personal website with a layered, wind-animated Vermouth portrait.",
  "scripts": {
    "prebuild": "npm test",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none scripts/tests/test_voxel.mjs scripts/tests/test_portrait.mjs scripts/tests/test_asset_loading.mjs scripts/tests/test_site_content.mjs",
    "deploy": "bash scripts/deploy/deploy_gh_pages.sh",
    "assets": "python3 scripts/assets/optimize_assets.py",
    "assets:check": "python3 scripts/assets/optimize_assets.py --check",
    "assets:verify": "python3 scripts/assets/verify_assets.py"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
